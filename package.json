{
  "name": "WasMusicorElectron",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "description": "一个融合electron + Vue3 + wasm的跨端桌面程序Music工具DAW集成",
  "author": {
    "name": "WasMusicorElectron",
    "email": "tridu33@qq.com",
    "url": "",
    "com": ""
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "url": "https://github.com/slamkun/WasMusicorElectron"
  },
  "main": "electron.main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=\"development\" && concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "build": "rm -rf ./dist_web && rm -rf ./dist && vite build && electron-builder",
    "preview": "vite preview",
    "generate": "vite-ssg build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit"
  },
  "scripts注释": "generate生成dist_web文件夹.preview前置generate, 读取dist_web文件夹开发server可用chrome预览.build生成dist文件夹.",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vueuse/core": "^12.0.0",
    "element-plus": "^2.9.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@iconify-json/ep": "^1.2.1",
    "@iconify-json/ri": "^1.2.3",
    "@types/node": "^20.17.10",
    "@unocss/eslint-plugin": "^0.65.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-format": "^0.1.3",
    "sass": "^1.82.0",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "unplugin-vue-components": "^0.27.5",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.0.3",
    "vite-ssg": "^0.24.2",
    "vue-tsc": "^2.1.10"
  }
}
