{
  "name": "WasMuscore",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "description": "一个融合electron + Vue3 + wasm的跨端桌面程序Music工具DAW集成",
  "author": {
    "name": "WasMuscore",
    "email": "tridu33@qq.com",
    "url": "",
    "com": ""
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "url": "https://github.com/slamkun/WasMuscore"
  },
  "main": "electron.main.js",
  "scripts注释": [
    "start开发模式, electron和vite同时运行",
    "如果electron安装失败缺少path.txt文件就npm run postinstall",
    "generate生成dist_web文件夹",
    "preview前置需执行generate, 然后读取dist_web文件夹开发server可用chrome预览",
    "typecheck类型检查",
    "lint代码检查",
    "build生成dist文件夹"
  ],
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "preview": "pnpm run generate && vite preview",
    "generate": "vite-ssg build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf ./dist_web && rm -rf ./dist && rm -rf ./rust_generated && rm -rf ./wasm/pkg/",
    "build:wasm": "npm run clean && bash build.sh",
    "build": "npm run build:wasm && vue-tsc --noEmit && vite build && electron-builder",
    "start": "cross-env NODE_ENV=\"development\" && concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "watch:wasm": "cd wasm && cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-pack build --target web --dev\"",
    "dev": "npm run watch:wasm & vite"
  },
  "config": {
    "electron": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@stringsync/musicxml": "^0.3.0",
    "@vueuse/core": "^12.0.0",
    "@webgpu/types": "^0.1.70",
    "element-plus": "^2.9.5",
    "opensheetmusicdisplay": "^1.9.9",
    "pinia": "^3.0.4",
    "sf2-player": "^0.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@iconify-json/ep": "^1.2.1",
    "@iconify-json/ri": "^1.2.3",
    "@types/node": "^20.17.10",
    "@unocss/eslint-plugin": "^0.65.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-format": "^0.1.3",
    "lodash": "^4.17.21",
    "postcss": "^8.4.7",
    "sass": "^1.82.0",
    "tailwindcss": "^3.0.23",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "unplugin-vue-components": "^0.27.5",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vite-plugin-wasm-pack": "^0.1.9",
    "vite-ssg": "^0.24.2",
    "vue-tsc": "^2.1.10"
  }
}
