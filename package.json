{
  "name": "Wascore",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "description": "一个融合electron + Vue3 + wasm的跨端桌面程序Music工具DAW集成",
  "author": {
    "name": "Wascore",
    "email": "tridu33@qq.com",
    "url": "",
    "com": ""
  },
  "license": "MIT",
  "homepage": "",
  "repository": {
    "url": "https://github.com/slamkun/Wascore"
  },
  "main": "electron.main.js",
  "scripts注释": [
    "start开发模式, electron和vite同时运行",
    "如果electron安装失败缺少path.txt文件就npm run postinstall",
    "generate生成dist_web文件夹",
    "preview前置需执行generate, 然后读取dist_web文件夹开发server可用chrome预览",
    "typecheck类型检查",
    "lint代码检查",
    "build生成dist文件夹"
  ],
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "preview": "pnpm run generate && vite preview",
    "generate": "vite-ssg build",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "clean": "rm -rf ./dist_web && rm -rf ./dist && rm -rf ./rust_generated && rm -rf ./wasm/pkg/",
    "build:wasm": "npm run clean && bash build.sh",
    "build": "npm run build:wasm && vue-tsc --noEmit && vite build && electron-builder",
    "start": "concurrently --kill-others-on-fail \"pnpm run dev:backend\" \"vite\" \"wait-on tcp:3000 && electron .\"",
    "serve": "concurrently \"pnpm run dev:backend\" \"vite --port 10001 --host 0.0.0.0\"",
    "dev:backend": "cd backend && npx tsx src/app.ts",
    "db:init": "mysql -u root -p\"Kwd906091\" < backend/init.sql",
    "watch:wasm": "cd wasm_rust && cargo watch -i .gitignore -i \"pkg/*\" -s \"wasm-bindgen target/wasm32-unknown-unknown/debug/wasmusicorelectron.wasm --out-dir ./pkg/ --target web\"",
    "dev": "npm run watch:wasm & vite",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "config": {
    "electron": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    }
  },
  "dependencies": {
    "@coderline/alphatab": "^1.8.3",
    "@element-plus/icons-vue": "^2.3.1",
    "@logue/sf2synth": "^0.9.0",
    "@stringsync/musicxml": "^0.3.0",
    "@tonejs/midi": "^2.0.28",
    "@vueuse/core": "^12.0.0",
    "@webgpu/types": "^0.1.70",
    "abcjs": "^6.6.3",
    "axios": "^1.17.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "element-plus": "^2.9.5",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "guitarpro-parser": "^1.2.0",
    "jspdf": "^4.2.1",
    "monaco-editor": "^0.55.1",
    "mysql2": "^3.22.5",
    "opensheetmusicdisplay": "^1.9.9",
    "pinia": "^3.0.4",
    "tone": "^15.1.22",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@iconify-json/ep": "^1.2.1",
    "@iconify-json/ri": "^1.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/node": "^20.17.10",
    "@unocss/eslint-plugin": "^0.65.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "eslint-plugin-format": "^0.1.3",
    "jsdom": "^29.1.1",
    "lodash": "^4.17.21",
    "node-web-audio-api": "^2.0.0",
    "postcss": "^8.4.7",
    "sass": "^1.82.0",
    "tailwindcss": "^3.0.23",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "unocss": "^0.65.1",
    "unplugin-vue-components": "^0.27.5",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vite-plugin-wasm-pack": "^0.1.9",
    "vite-ssg": "^0.24.2",
    "vitest": "^4.1.8",
    "vitest-webgl-canvas-mock": "^1.1.0",
    "vue-tsc": "^2.1.10",
    "wait-on": "^9.0.10",
    "web-audio-api": "^1.5.1",
    "web-audio-engine": "^0.13.4",
    "webaudio-node": "^0.8.0"
  }
}
